  },
  "devDependencies": {
    "@types/node": "24.19.2",
    "typescript": "5.9.3",
    "vite": "8.3.4"
  },
  "dependencies": {
    "@wailsio/runtime": "3.0.0-beta.24",
    "markdown-it": "15.0.3"
  }
}
